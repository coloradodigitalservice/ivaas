    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get access token",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{authClientId}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{authClientSecret}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "{{authScope}}",
                  "type": "text"
                }
              ]
            },
            "url": "{{authTokenUrl}}",
            "description": "Exercise the configured client-credentials token endpoint directly. Protected API requests acquire their own token in the collection pre-request script and do not depend on this request running first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tokenResponse = pm.response.json();",
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns a Bearer access token with the required scope', () => {",
                  "  pm.expect(tokenResponse.access_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(tokenResponse.token_type.toLowerCase()).to.equal('bearer');",
                  "  const tokenParts = tokenResponse.access_token.split('.');",
                  "  pm.expect(tokenParts).to.have.lengthOf(3);",
                  "  pm.expect(tokenParts.every((part) => part.length > 0)).to.equal(true);",
                  "  const grantedScopes = (tokenResponse.scope || '').split(/\\s+/);",
                  "  pm.expect(grantedScopes).to.include(pm.variables.get('authScope'));",
                  "});"
                ]
              }
            }
          ]
        },
