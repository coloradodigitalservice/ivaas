{
  "info": {
    "_postman_id": "99ddd3b9-b63c-40b0-ae58-1d9d1dfae837",
    "name": "IVaaS API",
    "description": "Development and contract-testing requests for the IVaaS API. Protected requests automatically obtain a client-credentials access token in the collection pre-request script and attach it without persisting the token between requests. The committed OAuth client values target the containerized local OAuth server; override the configuration variables with Postman environment variables for another deployment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api",
      "type": "string",
      "description": "IVaaS API base URL without a trailing slash."
    },
    {
      "key": "apiVersion",
      "value": "v1",
      "type": "string",
      "description": "Must match the application's API_VERSION setting."
    },
    {
      "key": "correlationId",
      "value": "",
      "type": "string",
      "description": "Generated before every request as a UUIDv4 with a Postman reference suffix."
    },
    {
      "key": "authTokenUrl",
      "value": "http://127.0.0.1:8090/default/token",
      "type": "string",
      "description": "OAuth2 token endpoint for the selected environment."
    },
    {
      "key": "authClientId",
      "value": "local-client",
      "type": "string",
      "description": "OAuth2 client ID; the committed value is only for the local mock server."
    },
    {
      "key": "authClientSecret",
      "value": "local-secret",
      "type": "string",
      "description": "OAuth2 client secret; the committed value is only for the local mock server."
    },
    {
      "key": "authScope",
      "value": "ivaas/income.verify",
      "type": "string",
      "description": "Scope required by protected IVaaS operations."
    },
    {
      "key": "expectedAuthenticatedAgency",
      "value": "local-agency",
      "type": "string",
      "description": "Agency expected from Test connection for the selected OAuth client."
    },
    {
      "key": "expectedDeploymentEnvironment",
      "value": "local",
      "type": "string",
      "description": "Application environment expected from Test connection."
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const correlationId = pm.variables.replaceIn('{{$guid}}') + ':postman';",
          "pm.collectionVariables.set('correlationId', correlationId);",
          "",
          "// Obtain and attach the token within one script execution. This deliberately avoids",
          "// persisting JWTs in Postman variables, which can abbreviate long values between requests.",
          "const authMarker = 'X-Postman-Use-IVaaS-Token';",
          "if (pm.request.headers.get(authMarker) === 'true') {",
          "  const tokenResponse = await pm.sendRequest({",
          "    url: pm.variables.get('authTokenUrl'),",
          "    method: 'POST',",
          "    auth: {",
          "      type: 'basic',",
          "      basic: [",
          "        { key: 'username', value: pm.variables.get('authClientId'), type: 'string' },",
          "        { key: 'password', value: pm.variables.get('authClientSecret'), type: 'string' },",
          "      ],",
          "    },",
          "    header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "    body: {",
          "      mode: 'urlencoded',",
          "      urlencoded: [",
          "        { key: 'grant_type', value: 'client_credentials', type: 'text' },",
          "        { key: 'scope', value: pm.variables.get('authScope'), type: 'text' },",
          "      ],",
          "    },",
          "  });",
          "  if (tokenResponse.code !== 200) {",
          "    throw new Error(`OAuth token endpoint returned ${tokenResponse.code}.`);",
          "  }",
          "  const tokenBody = tokenResponse.json();",
          "  const accessToken = tokenBody.access_token;",
          "  const tokenSegments = typeof accessToken === 'string' ? accessToken.split('.') : [];",
          "  if (tokenBody.token_type.toLowerCase() !== 'bearer' || tokenSegments.length !== 3 || tokenSegments.some((segment) => !segment)) {",
          "    throw new Error('OAuth token endpoint did not return a complete Bearer JWT.');",
          "  }",
          "  pm.request.headers.remove(authMarker);",
          "  pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${accessToken}` });",
          "}"
        ]
      }
    }
  ],
